t.abs      = math.abs(-5) == 5;
t.acos     = math.round(math.acos(1)) == 0;
t.asin     = math.round(math.asin(1)) == 90;
t.atan     = math.round(math.atan(1)) == 45;
t.atan2    = math.round(math.atan2(1, 1)) == 45;
t.ceil     = math.ceil(1.2) == 2;
t.clamp    = math.clamp(15, 0, 10) == 10;
t.cos      = math.round(math.cos(0)) == 1;
t.exp      = math.round(math.exp(1) * 1000) == 2718;
t.floor    = math.floor(1.9) == 1;
t.hermite  = math.hermite_blend(0) == 0;
t.lerp     = math.lerp(0, 10, 0.5) == 5;
t.lerprot  = math.lerprotate(350, 10, 0.5) == 0;
t.ln       = math.round(math.ln(math.exp(1))) == 1;
t.max      = math.max(5, 10) == 10;
t.min      = math.min(5, 10) == 5;
t.minang   = math.min_angle(270) == -90;
t.mod      = math.mod(10, 3) == 1;
t.pi       = math.round(math.pi * 1000) == 3142;
t.pow      = math.pow(2, 3) == 8;
t.round    = math.round(1.6) == 2;
t.sin      = math.round(math.sin(90)) == 1;
t.sqrt     = math.sqrt(25) == 5;
t.trunc    = math.trunc(1.9) == 1 && math.trunc(-1.9) == -1;

t.random =
    math.random(5, 10) >= 5 &&
    math.random(5, 10) <= 10;

t.random_int =
    math.random_integer(1, 3) >= 1 &&
    math.random_integer(1, 3) <= 3;

t.die_roll =
    math.die_roll(2, 1, 6) >= 2 &&
    math.die_roll(2, 1, 6) <= 12;

t.die_roll_int =
    math.die_roll_integer(2, 1, 6) >= 2 &&
    math.die_roll_integer(2, 1, 6) <= 12;

return (
    t.abs &&
    t.acos &&
    t.asin &&
    t.atan &&
    t.atan2 &&
    t.ceil &&
    t.clamp &&
    t.cos &&
    t.exp &&
    t.floor &&
    t.hermite &&
    t.lerp &&
    t.lerprot &&
    t.ln &&
    t.max &&
    t.min &&
    t.minang &&
    t.mod &&
    t.pi &&
    t.pow &&
    t.random &&
    t.random_int &&
    t.round &&
    t.sin &&
    t.sqrt &&
    t.trunc &&
    t.die_roll &&
    t.die_roll_int
);